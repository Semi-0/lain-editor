{:paths ["src" "resources"]
 :deps {lain-editor/contracts {:local/root "contracts"}
        missionary/missionary {:mvn/version "b.47"}
        no.cjohansen/replicant {:mvn/version "2026.07.1"}}
 :aliases {:quality-test {:replace-paths ["dev"]
                          :replace-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                                         clj-kondo/clj-kondo {:mvn/version "2026.08.04"}
                                         dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
                          :jvm-opts ["-Xmx768m"]
                          :main-opts ["-m" "quality-test"]}
           :lint {:replace-paths ["dev"]
                  :replace-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                                 clj-kondo/clj-kondo {:mvn/version "2026.08.04"}
                                 dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
                  :jvm-opts ["-Xmx768m"]
                  :main-opts ["-m" "quality" "lint"]}
           :format-check {:replace-paths ["dev"]
                          :replace-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                                         clj-kondo/clj-kondo {:mvn/version "2026.08.04"}
                                         dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
                          :jvm-opts ["-Xmx768m"]
                          :main-opts ["-m" "quality" "format-check"]}
           :format-fix {:replace-paths ["dev"]
                        :replace-deps {org.clojure/clojure {:mvn/version "1.12.0"}
                                       clj-kondo/clj-kondo {:mvn/version "2026.08.04"}
                                       dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
                        :jvm-opts ["-Xmx768m"]
                        :main-opts ["-m" "quality" "format-fix"]}
           :test {:extra-paths ["test"]
                  :extra-deps {org.clojure/data.json {:mvn/version "2.5.2"}}
                  :main-opts ["-m" "lain-editor.test-runner"]}
           :editor/cljs {:extra-paths ["build"]
                         :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}}
                         :main-opts ["-m" "lain-editor.build"]}
           :editor/cljs-test {:extra-paths ["build" "test"]
                              :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}}
                              :main-opts ["-m" "lain-editor.build" "test"]}}}
