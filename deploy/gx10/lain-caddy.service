[Unit]
Description=Lain LAN HTTPS gateway
After=network-online.target lain-authelia.service lain-editor.service
Wants=network-online.target
Requires=lain-authelia.service lain-editor.service

[Service]
User=caddy
Group=caddy
StateDirectory=lain-caddy
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/lain-caddy
Environment=XDG_CONFIG_HOME=/var/lib/lain-caddy
ExecStartPre=/usr/bin/caddy validate --config /etc/lain-editor/caddy/Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /etc/lain-editor/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lain-caddy
InaccessiblePaths=/srv/lain/projects /etc/lain-editor/editor /etc/lain-editor/runtime /etc/lain-editor/authelia /var/lib/lain-authelia
UMask=0077

[Install]
WantedBy=multi-user.target
